# ─── Hedera Network ───────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet

# ─── Agent Accounts (fund each with ~10 HBAR from faucet.hedera.com) ─────────
AGENT_GREG_ACCOUNT_ID=0.0.xxxxx
AGENT_GREG_PRIVATE_KEY=302e020100300506032b657004220420...

AGENT_PAT_ACCOUNT_ID=0.0.xxxxx
AGENT_PAT_PRIVATE_KEY=302e020100300506032b657004220420...

AGENT_CLAUDE_ACCOUNT_ID=0.0.xxxxx
AGENT_CLAUDE_PRIVATE_KEY=302e020100300506032b657004220420...

AGENT_HANNAH_ACCOUNT_ID=0.0.xxxxx
AGENT_HANNAH_PRIVATE_KEY=302e020100300506032b657004220420...

# ─── Facilitator Account (pays Hedera network fees, fund with ~5 HBAR) ───────
# This account signs and submits transactions on behalf of all agents
FACILITATOR_ACCOUNT_ID=0.0.xxxxx
FACILITATOR_PRIVATE_KEY=302e020100300506032b657004220420...

# ─── Optional: AI dialogue (if unset, uses built-in rule-based dialogue) ─────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Frontend config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/testnet
NEXT_PUBLIC_DEMO_MODE=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
